# Пример секретов. Локально: скопируйте в .streamlit/secrets.toml (в git он не попадает).
# На Streamlit Cloud: App → Settings → Secrets — вставьте эти строки со своими значениями.

OPENAI_API_KEY = ""

# Supabase → кнопка Connect → вкладка Session pooler → скопировать URI и вставить пароль базы.
# Без этой строки сайт хранит аккаунты и баллы в локальном файле data/app.db (на Streamlit Cloud он стирается).
# DATABASE_URL = "postgresql://postgres.<id проекта>:<пароль базы>@aws-0-<регион>.pooler.supabase.com:5432/postgres"
